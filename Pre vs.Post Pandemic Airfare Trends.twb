        <annotations>
          <annotation class='point' id='1' mark-position='1' pullback='12' text-width='180'>
            <formatted-text>
              <run fontcolor='#000000'>The average fare of flights dipped in </run>
              <run fontcolor='#ff0000'>2020</run>
              <run fontcolor='#000000'> due to the COVID-19 outbreak.</run>
            </formatted-text>
            <point>
              <visual-coordinate class='mark'>
